<?xml version="1.0"?>
<!-- Cluttered demo world: a walled room with dense pillars and angled baffles, and no long
     featureless interior wall. Start (0.0, 0.0), goal (7.0, -1.0); the route detours through
     the structure. -->
<sdf version="1.8">
  <world name="cluttered_demo">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><direction>-0.5 0.1 -0.9</direction>
      <diffuse>1 1 1 1</diffuse><specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-1.6 0.0 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>8.6 0.0 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>3.5 -4.1 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_n">
      <static>true</static>
      <pose>3.5 4.1 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>10.2 0.2 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>10.2 0.2 0.6</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="baffle_c">
      <static>true</static>
      <pose>3.0 0.4 0.3 0 0 0.52</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 2.8 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.8 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="baffle_ne">
      <static>true</static>
      <pose>5.6 2.4 0.3 0 0 -0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 2.0 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 2.0 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="baffle_sw">
      <static>true</static>
      <pose>1.4 -2.4 0.3 0 0 0.7</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.8 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.8 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="baffle_e">
      <static>true</static>
      <pose>5.7 -1.9 0.3 0 0 -0.35</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 1.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 1.6 0.6</size></box></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_1">
      <static>true</static>
      <pose>1.2 1.9 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.45 0.45 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.45 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_2">
      <static>true</static>
      <pose>4.6 1.7 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_3">
      <static>true</static>
      <pose>4.9 -2.3 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_4">
      <static>true</static>
      <pose>6.2 1.1 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_5">
      <static>true</static>
      <pose>2.1 -1.1 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_6">
      <static>true</static>
      <pose>0.6 -1.8 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 0.35 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 0.35 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pil_7">
      <static>true</static>
      <pose>7.6 1.6 0.3 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.45 0.45 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.45 0.45 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.3 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
