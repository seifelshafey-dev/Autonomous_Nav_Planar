<?xml version="1.0"?>
<!--
  ros2_control hardware interface for the reference diff-drive base.

  Hardware plugin is selected by the use_mock_hardware xacro arg:
    true  -> mock_components/GenericSystem      (no simulator; mirrors
             each wheel velocity command straight into its velocity/position
             state, so the diff_drive_controller integrates ideal odometry)
    false -> ign_ros2_control/IgnitionSystem    (Gazebo Fortress; the
             ign_ros2_control-system gazebo plugin below hosts the
             controller_manager inside the sim)

  Each driven-wheel joint exposes a velocity command interface plus position +
  velocity state interfaces (the interfaces diff_drive_controller requires).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="reference_robot">

    <ros2_control name="RobotSystem" type="system">
        <hardware>
            <xacro:if value="${use_mock_hardware}">
                <plugin>mock_components/GenericSystem</plugin>
                <!-- Integrate each wheel's position state from its commanded
                     velocity so diff_drive_controller's position-delta odometry
                     advances (without this, wheel position stays 0 and /odom
                     never moves). -->
                <param name="calculate_dynamics">true</param>
            </xacro:if>
            <xacro:unless value="${use_mock_hardware}">
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </xacro:unless>
        </hardware>

        <joint name="left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <!--
      Simulation only: the ign_ros2_control-system gazebo plugin hosts the
      controller_manager INSIDE the Gazebo process, loading controllers.yaml and
      driving the IgnitionSystem hardware above from sim time. Guarded so it
      never appears on the mock-hardware path (which runs a standalone
      ros2_control_node). With this plugin the sim launch must NOT also start a
      ros2_control_node; the controller_manager lives inside this plugin.
    -->
    <xacro:unless value="${use_mock_hardware}">
        <gazebo>
            <plugin filename="ign_ros2_control-system"
                    name="ign_ros2_control::IgnitionROS2ControlPlugin">
                <parameters>$(find robot_bringup)/config/controllers.yaml</parameters>
                <controller_manager_name>controller_manager</controller_manager_name>
            </plugin>
            <!-- True model pose in the Gazebo world frame, for diagnosis only.
                 No tf_topic: nothing is added to ROS /tf. -->
            <plugin filename="ignition-gazebo-odometry-publisher-system"
                    name="ignition::gazebo::systems::OdometryPublisher">
                <odom_frame>world</odom_frame>
                <robot_base_frame>base_link</robot_base_frame>
                <odom_topic>/ground_truth/odom</odom_topic>
                <odom_publish_frequency>50</odom_publish_frequency>
                <dimensions>2</dimensions>
            </plugin>
        </gazebo>
    </xacro:unless>

</robot>
