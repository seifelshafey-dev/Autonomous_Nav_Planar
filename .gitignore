# scenario_studio bundles: scenarios/<name>/ holds a map binary + scenario YAML + generated output/.
# Ignored wholesale for now (large map binaries + scratch outputs). The committed CI corpus lives at
# test/integration/scenarios/ (a different path) and stays tracked.
src/path_planner/scenarios/

# Serialized SLAM pose graphs (regenerable, ~18 MB each)
src/robot_bringup/maps/*.posegraph
src/robot_bringup/maps/*.data

# Generated per-scenario output (search traces, renders) in the tracked CI corpus
src/path_planner/test/integration/scenarios/*/output/
